{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "scripts/assets/*.ts"],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["pino-pretty", "tailwindcss"]
}
