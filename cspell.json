{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaryDefinitions": [
    {
      "name": "ltf-words",
      "path": "./cspell-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["ltf-words"],
  "files": ["content/**/*.{md,yaml}", "README.md"],
  "ignorePaths": [
    "node_modules",
    "dist",
    "coverage",
    "src/test/**",
    "**/*.test.{ts,tsx}",
    "content/**/README.md"
  ],
  "ignoreRegExpList": [
    "\\{\\{[^}]+\\}\\}",
    "\\[\\[[^\\]]+\\]\\]",
    "\\*\\*[A-Za-z]{1,2}\\*\\*[a-z]+"
  ]
}
