# Copy to .env and fill in. See plan.md Appendix E for details.
# Never commit .env. Anything prefixed VITE_ is public (bundled into client JS).

NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/learntofly
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_NAME=ltf.sid
PUBLIC_SITE_URL=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=debug
RATE_LIMIT_ENABLED=true

# P1 / optional
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
GIT_SHA=

# Client (build time, public)
VITE_APP_NAME=Learn-To-Fly
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_SENTRY_DSN=
VITE_ANALYTICS_DOMAIN=
